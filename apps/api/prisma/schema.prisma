generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  TEAM_LEAD
  UI_UX
  ENGINEER
  QA
  DEVOPS
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum PitchStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum FeatureStatus {
  PROPOSED
  PLANNED
  IN_PROGRESS
  QA
  READY_FOR_REVIEW
  RELEASED
}

enum PitchReviewAction {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

enum AgentDecisionStatus {
  PENDING
  APPROVED
  EXECUTING
  REJECTED
  EXECUTED
  BLOCKED
  FAILED
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  CANCELLED
}

enum GovernanceDomain {
  ARCHITECTURE
  PRIVACY
  SECURITY
  INFRASTRUCTURE
  COST
}

enum GovernanceReviewStatus {
  OPEN
  DEBATING
  RECOMMENDED
  REQUIRES_HUMAN_REVIEW
  RESOLVED
}

enum GovernanceOpinionStance {
  SUPPORT
  OPPOSE
  CONDITIONAL
  ABSTAIN
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  repository  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features      Feature[]
  pitches       Pitch[]
  agentDecisions AgentDecision[]
  agentRuns      AgentRun[]
  governanceReviews GovernanceReview[]
}

model Employee {
  id          String         @id @default(cuid())
  name        String
  role        EmployeeRole
  status      EmployeeStatus @default(ACTIVE)
  color       String         @default("#71717a")
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Feature {
  id          String        @id @default(cuid())
  title       String
  description String
  status      FeatureStatus @default(PROPOSED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  pitches Pitch[]
  tasks   Task[]
}

model Pitch {
  id          String      @id @default(cuid())
  title       String
  description String
  rationale   String?
  problem     String?
  solution    String?
  impact      String?
  risks       String?
  status      PitchStatus @default(PENDING_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  featureId String?
  feature   Feature? @relation(fields: [featureId], references: [id], onDelete: Cascade)

  reviews        PitchReview[]
  taskSuggestions PitchTaskSuggestion[]
}

model PitchReview {
  id        String            @id @default(cuid())
  action    PitchReviewAction
  comment   String?

  createdAt DateTime @default(now())

  pitchId String
  pitch   Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)
}

model PitchTaskSuggestion {
  id                 String       @id @default(cuid())
  title              String
  description        String?
  acceptanceCriteria String?
  role               EmployeeRole

  createdAt DateTime @default(now())

  pitchId String
  pitch   Pitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@index([pitchId])
}

model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String?
  acceptanceCriteria String?
  status             TaskStatus @default(TODO)

  githubIssueNumber Int?
  githubIssueUrl    String?
  branchName        String?
  pullRequestNumber Int?
  pullRequestUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  agentRuns   AgentRun[]
}

model GithubWebhookEvent {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  event      String
  action     String?
  repository String?
  payload    Json

  processedAt DateTime?
  error       String?

  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model AgentDecision {
  id String @id @default(cuid())

  agent     String
  type      String
  priority  String
  title     String
  reasoning String

  evidence Json
  actions  Json

  requiresCeoApproval Boolean
  status               AgentDecisionStatus @default(PENDING)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedAt DateTime?
  rejectedAt DateTime?
  executedAt DateTime?

  resolutionComment String?

  @@index([projectId])
  @@index([status])
  @@index([agent])
  @@index([createdAt])
}

model RuntimeLease {
  key       String   @id
  owner     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model AgentRun {
  id          String         @id @default(cuid())
  agent       String
  kind        String
  status      AgentRunStatus @default(RUNNING)
  attempt     Int            @default(1)
  maxAttempts Int            @default(3)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([status, createdAt])
  @@index([agent, kind, createdAt])
}

model GovernanceReview {
  id                  String                 @id @default(cuid())
  domain              GovernanceDomain
  status              GovernanceReviewStatus @default(OPEN)
  subjectType         String
  subjectId           String?
  title               String
  context             Json
  recommendation      String?
  dissent             String?
  requiresHumanReview Boolean                @default(false)
  projectId           String
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opinions            GovernanceOpinion[]
  findings            GovernanceFinding[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@index([domain, createdAt])
}

model GovernanceOpinion {
  id         String                 @id @default(cuid())
  agent      String
  role       String
  stance     GovernanceOpinionStance
  rationale  String
  evidence   Json
  round      Int                    @default(1)
  reviewId   String
  review     GovernanceReview       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())

  @@index([reviewId, round])
}

model GovernanceFinding {
  id          String           @id @default(cuid())
  severity    String
  category    String
  title       String
  description String
  remediation String?
  reviewId    String
  review      GovernanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([reviewId])
}
