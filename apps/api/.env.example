DATABASE_URL="postgresql://forge:forge_dev_password@localhost:5433/forge?schema=public"

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH="apps/api/secrets/github-app.pem"
GITHUB_WEBHOOK_SECRET=
# Agent runtime
AGENT_RUNTIME="deterministic"
# Hermes Agent runtime
HERMES_COMMAND="hermes"
HERMES_WORKDIR=
HERMES_TIMEOUT_MS="300000"
TEAM_LEAD_AGENT="deterministic"
FORGE_AUTONOMOUS="false"
FORGE_AUTONOMOUS_INTERVAL_MS="300000"
FORGE_WORKSPACE_ROOT="/tmp/forge-workspaces"
FORGE_MEMORY_ROOT="../../memory"

# Reliability / concurrency
FORGE_LEASE_TTL_MS="900000"
AGENT_RUN_STALE_MS="900000"
AGENT_DECISION_STALE_MS="900000"

# API security. Leave unset for local development; production deployments should set a long random value.
FORGE_API_KEY=""
