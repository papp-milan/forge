DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge?schema=public"
PORT="3000"
NODE_ENV="development"

# Comma-separated browser origins allowed to call the API.
# Example: https://forge.example.com,http://localhost:5173
FORGE_CORS_ORIGINS=""

# When set, mutations and sensitive reads require this API key.
FORGE_API_KEY=""

# Per-IP in-memory rate limit. Set to 0 to disable.
FORGE_RATE_LIMIT_PER_MINUTE="300"

AGENT_RUNTIME="deterministic"
HERMES_COMMAND="hermes"
HERMES_WORKDIR=""
HERMES_TIMEOUT_MS="300000"
TEAM_LEAD_AGENT="deterministic"
FORGE_AUTONOMOUS="false"
FORGE_AUTONOMOUS_INTERVAL_MS="300000"
FORGE_WORKSPACE_ROOT="/tmp/forge-workspaces"
FORGE_MEMORY_ROOT="../../memory"
FORGE_LEASE_TTL_MS="900000"
AGENT_RUN_STALE_MS="900000"
AGENT_DECISION_STALE_MS="900000"
