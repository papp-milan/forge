# Forge production environment
# Copy this file to /opt/forge/.env.production on the VPS.
# Never commit the real file.

POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

GITHUB_APP_ID=CHANGE_ME
GITHUB_INSTALLATION_ID=CHANGE_ME
GITHUB_WEBHOOK_SECRET=CHANGE_ME
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

FORGE_AUTONOMOUS=false
FORGE_AUTONOMOUS_INTERVAL_MS=300000
FORGE_WORKSPACE_ROOT=/workspace
FORGE_MEMORY_ROOT=/app/memory

HERMES_COMMAND=hermes
HERMES_WORKDIR=/workspace
HERMES_TIMEOUT_MS=300000
